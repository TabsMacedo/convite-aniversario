# Opcional: sem este arquivo, o primeiro npm start gera uma senha e a mostra no terminal.
# Copie para .env e preencha uma senha de pelo menos 12 caracteres para escolher a sua.
# ADMIN_PASSWORD=

HOST=127.0.0.1
PORT=3000

# Na hospedagem, use HTTPS, defina a URL pública e um disco persistente:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://seu-dominio.com.br
# DATA_DIR=/caminho/do/disco-persistente/tabata
# HOST=0.0.0.0

# Opcional: segredo JWT com pelo menos 32 caracteres.
# Se omitido, um segredo aleatório será criado no diretório de dados.
# JWT_SECRET=
